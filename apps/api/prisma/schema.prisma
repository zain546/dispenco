datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id               String         @id @default(uuid())
  name             String
  logoUrl          String?
  expiryAlertDays  Int            @default(90)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  users            User[]
  roles            Role[]
  stores           Store[]
  products         Product[]
  batches          Batch[]
  suppliers        Supplier[]
  purchaseOrders   PurchaseOrder[]
  customers        Customer[]
  sales            Sale[]
  payments         Payment[]
  returns          Return[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  taxRates         TaxRate[]
  transfers        StockTransfer[]
  prescriptions    Prescription[]
  apiKeys          ApiKey[]
  anomalyFlags     AnomalyFlag[]
  subscription     Subscription?
}

model User {
  id                 String           @id @default(uuid())
  tenantId           String
  email              String
  passwordHash       String
  refreshTokenHash   String?
  tokenVersion       Int              @default(1)
  name               String
  phone              String?
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles          UserRole[]
  sales              Sale[]
  returns            Return[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  requestedTransfers StockTransfer[]  @relation("RequestedByUser")
  dispatchedTransfers StockTransfer[] @relation("DispatchedByUser")
  receivedTransfers  StockTransfer[]  @relation("ReceivedByUser")
  flaggedAnomalies   AnomalyFlag[]    @relation("FlaggedUser")
  reviewedAnomalies  AnomalyFlag[]    @relation("ReviewedByUser")

  @@unique([tenantId, email])
}

model Role {
  id              String           @id @default(uuid())
  tenantId        String
  name            String
  isDefault       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, name])
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Store {
  id              String          @id @default(uuid())
  tenantId        String
  name            String
  address         String?
  currency        String          @default("PKR")
  taxRate         Decimal         @default(0.0) @db.Decimal(5, 2)
  receiptFooter   String?
  logoUrl         String?
  isActive        Boolean         @default(true)
  expiryAlertDays Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches         Batch[]
  purchaseOrders     PurchaseOrder[]
  sales              Sale[]
  outgoingTransfers  StockTransfer[] @relation("SourceStore")
  incomingTransfers  StockTransfer[] @relation("TargetStore")
  prescriptions      Prescription[]
  anomalyFlags       AnomalyFlag[]
}

model Product {
  id                   String         @id @default(uuid())
  tenantId             String
  name                 String
  genericName          String?
  category             String
  unit                 String
  barcode              String?
  images               String[]
  taxCode              String?
  isControlledSubstance Boolean        @default(false)
  isActive             Boolean        @default(true)
  lowStockThreshold    Int            @default(10)
  attributes           Json           @default("{}")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches              Batch[]
  purchaseItems        PurchaseItem[]
  saleItems            SaleItem[]
  transferItems        StockTransferItem[]
  prescriptionItems    PrescriptionItem[]

  @@index([tenantId, barcode])
  @@index([attributes], type: Gin)
}

model Batch {
  id                String         @id @default(uuid())
  tenantId          String
  storeId           String
  productId         String
  batchNumber       String
  expiryDate        DateTime
  costPrice         Decimal        @db.Decimal(12, 2)
  sellPrice         Decimal        @db.Decimal(12, 2)
  quantityReceived  Int
  quantityRemaining Int
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store             Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseItems     PurchaseItem[]
  saleItems         SaleItem[]
  transferItems     StockTransferItem[]

  @@index([tenantId, storeId])
  @@index([expiryDate])
}

model Supplier {
  id             String          @id @default(uuid())
  tenantId       String
  name           String
  contactPhone   String?
  contactEmail   String?
  address        String?
  leadTimeDays   Int             @default(3)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
}

enum PurchaseOrderStatus {
  PENDING
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  tenantId      String
  storeId       String
  supplierId    String
  orderNumber   String?
  status        PurchaseOrderStatus @default(PENDING)
  totalCost     Decimal             @default(0) @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store         Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseItems PurchaseItem[]

  @@index([tenantId, storeId])
}

model PurchaseItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  productId        String
  batchId          String?
  expectedQuantity Int
  receivedQuantity Int           @default(0)
  unitCost         Decimal       @db.Decimal(12, 2)

  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch            Batch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
}

model Customer {
  id            String    @id @default(uuid())
  tenantId      String
  name          String
  phone         String?
  email         String?
  address       String?
  creditBalance Decimal   @default(0) @db.Decimal(12, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales         Sale[]
  payments      Payment[]

  @@index([tenantId, phone])
  @@index([tenantId, name])
}

enum SaleStatus {
  COMPLETED
  VOIDED
  ON_CREDIT
}

model Sale {
  id             String     @id @default(uuid())
  tenantId       String
  storeId        String
  userId         String
  customerId     String?
  receiptNumber  String?
  totalAmount    Decimal    @db.Decimal(12, 2)
  discountAmount Decimal    @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal    @db.Decimal(12, 2)
  status         SaleStatus @default(COMPLETED)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store          Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer       Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  saleItems      SaleItem[]
  payments       Payment[]
  returns        Return[]
  prescriptions  Prescription[]

  @@index([tenantId, receiptNumber])
}

enum DiscountType {
  FLAT
  PERCENT
}

model SaleItem {
  id           String       @id @default(uuid())
  saleId       String
  batchId      String
  productId    String
  quantity     Int
  unitPrice    Decimal      @db.Decimal(12, 2)
  discount     Decimal      @default(0) @db.Decimal(12, 2)
  discountType DiscountType @default(FLAT)
  taxRate      Decimal      @default(0) @db.Decimal(5, 2)
  taxApplied   Decimal      @default(0) @db.Decimal(12, 2)

  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  batch        Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  returnItems  ReturnItem[]
}

enum PaymentMethod {
  CASH
  DIGITAL
  CREDIT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model Payment {
  id          String        @id @default(uuid())
  tenantId    String
  saleId      String?
  customerId  String?
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  gatewayRef  String?
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale        Sale?         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

model Return {
  id                 String       @id @default(uuid())
  tenantId           String
  saleId             String
  processedByUserId  String
  returnNumber       String?
  reason             String
  notes              String?
  refundAmount       Decimal      @default(0) @db.Decimal(12, 2)
  refundMethod       String       @default("CASH")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale               Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  processedByUser    User         @relation(fields: [processedByUserId], references: [id], onDelete: Cascade)
  returnItems        ReturnItem[]

  @@index([tenantId, saleId])
}

model ReturnItem {
  id           String   @id @default(uuid())
  returnId     String
  saleItemId   String
  quantity     Int
  unitPrice    Decimal  @default(0) @db.Decimal(12, 2)
  refundAmount Decimal  @default(0) @db.Decimal(12, 2)

  return       Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem     SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@index([tenantId, action])
}

model TaxRate {
  id          String   @id @default(uuid())
  tenantId    String
  code        String
  name        String
  ratePercent Decimal  @db.Decimal(5, 2)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

enum TransferStatus {
  REQUESTED
  DISPATCHED
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id                 String              @id @default(uuid())
  tenantId           String
  transferNumber     String
  sourceStoreId      String
  targetStoreId      String
  status             TransferStatus      @default(REQUESTED)
  requestedByUserId  String
  dispatchedByUserId String?
  receivedByUserId   String?
  dispatchedAt       DateTime?
  receivedAt         DateTime?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceStore        Store               @relation("SourceStore", fields: [sourceStoreId], references: [id], onDelete: Cascade)
  targetStore        Store               @relation("TargetStore", fields: [targetStoreId], references: [id], onDelete: Cascade)
  requestedByUser    User                @relation("RequestedByUser", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  dispatchedByUser   User?               @relation("DispatchedByUser", fields: [dispatchedByUserId], references: [id], onDelete: SetNull)
  receivedByUser     User?               @relation("ReceivedByUser", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  items              StockTransferItem[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId, sourceStoreId])
  @@index([tenantId, targetStoreId])
  @@index([tenantId, status])
}

model StockTransferItem {
  id                String         @id @default(uuid())
  transferId        String
  productId         String
  batchId           String?
  batchNumber       String?
  expiryDate        DateTime?
  costPrice         Decimal?       @db.Decimal(12, 2)
  sellPrice         Decimal?       @db.Decimal(12, 2)
  quantityRequested Int
  quantitySent      Int?
  quantityReceived  Int?

  transfer          StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch             Batch?         @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([transferId])
}

enum PrescriptionStatus {
  ACTIVE
  DISPENSED
  PARTIALLY_DISPENSED
  EXPIRED
  CANCELLED
}

model Prescription {
  id                  String             @id @default(uuid())
  tenantId            String
  storeId             String
  prescriptionNumber  String
  patientName         String
  patientPhone        String?
  patientAge          Int?
  patientGender       String?
  patientCnic         String?
  doctorName          String
  doctorLicenseNumber String?
  doctorHospital      String?
  prescriptionDate    DateTime           @default(now())
  expiryDate          DateTime?
  imageReference      String?
  diagnosis           String?
  notes               String?
  status              PrescriptionStatus @default(ACTIVE)
  saleId              String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store               Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sale                Sale?              @relation(fields: [saleId], references: [id], onDelete: SetNull)
  items               PrescriptionItem[]

  @@unique([tenantId, prescriptionNumber])
  @@index([tenantId, storeId])
  @@index([tenantId, patientPhone])
  @@index([tenantId, doctorName])
  @@index([tenantId, status])
}

model PrescriptionItem {
  id                 String       @id @default(uuid())
  prescriptionId     String
  productId          String
  dosage             String?
  frequency          String?
  durationDays       Int?
  quantityPrescribed Int
  quantityDispensed  Int          @default(0)
  instructions       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  prescription       Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@index([productId])
}

model ApiKey {
  id           String    @id @default(uuid())
  tenantId     String
  name         String
  keyPrefix    String
  keyHash      String
  permissions  String[]
  rateLimit    Int       @default(60)
  lastUsedAt   DateTime?
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([keyPrefix])
}

enum AnomalyType {
  HIGH_VOID_RATE
  EXCESSIVE_DISCOUNT
  AFTER_HOURS_SALE
  BELOW_COST_SALE
  REPETITIVE_SHRINKAGE
}

enum AnomalyStatus {
  FLAGGED
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model AnomalyFlag {
  id               String         @id @default(uuid())
  tenantId         String
  storeId          String?
  userId           String?
  type             AnomalyType
  severity         String         @default("MEDIUM")
  status           AnomalyStatus  @default(FLAGGED)
  title            String
  description      String
  statisticalScore Decimal?       @db.Decimal(10, 4)
  metricBaseline   Decimal?       @db.Decimal(12, 4)
  metricObserved   Decimal?       @db.Decimal(12, 4)
  referenceId      String?
  metadata         Json           @default("{}")
  resolutionNote   String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store            Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  user             User?          @relation("FlaggedUser", fields: [userId], references: [id], onDelete: SetNull)
  reviewedBy       User?          @relation("ReviewedByUser", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, storeId])
  @@index([tenantId, createdAt])
}

// ==========================================
// SAAS SUBSCRIPTION & BILLING
// ==========================================

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELED
}

enum BillingInvoiceStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

model Plan {
  id            String         @id @default(uuid())
  code          String         @unique // "STANDARD_MONTHLY"
  name          String         // "Standard Pharmacy"
  priceMinor    Int            // in paisa: 250000 = PKR 2,500
  currency      String         @default("PKR")
  intervalDays  Int            @default(30)
  maxStores     Int?
  maxUsers      Int?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                   String               @id @default(uuid())
  tenantId             String               @unique
  planId               String
  status               SubscriptionStatus   @default(TRIALING)
  trialEndsAt          DateTime
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  graceEndsAt          DateTime?
  cancelAtPeriodEnd    Boolean              @default(false)
  autoRenew            Boolean              @default(false)
  providerCustomerId   String?
  providerPaymentToken String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                 Plan                 @relation(fields: [planId], references: [id])
  invoices             SubscriptionInvoice[]

  @@index([status, currentPeriodEnd])
  @@index([status, trialEndsAt])
}

model SubscriptionInvoice {
  id                 String               @id @default(uuid())
  subscriptionId     String
  tenantId           String
  invoiceNumber      String               @unique
  amountMinor        Int
  currency           String               @default("PKR")
  status             BillingInvoiceStatus @default(PENDING)
  periodStart        DateTime
  periodEnd          DateTime
  provider           String               @default("SAFEPAY")
  providerTrackerId  String?              @unique
  providerPaymentRef String?
  paidAt             DateTime?
  failureReason      String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  subscription       Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model BillingWebhookEvent {
  id          String    @id
  provider    String    @default("SAFEPAY")
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  receivedAt  DateTime  @default(now())
}
