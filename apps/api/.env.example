# Dispenco API (NestJS) - Production Environment Template

# Server Port & Mode
PORT=4000
NODE_ENV=production

# Database (PostgreSQL with PgBouncer or direct connection)
DATABASE_URL="postgresql://dispenco_user:dispenco_password@localhost:5432/dispenco_db?schema=public"

# Authentication & Security Keys (Generate strong 64-character random strings in production)
JWT_SECRET="generate-a-strong-random-secret-key-for-jwt"
REFRESH_TOKEN_SECRET="generate-a-strong-random-secret-key-for-refresh-token"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_EXPIRATION="7d"

# Allowed CORS Origins (Comma-separated for multiple domains: e.g. https://dispenco.com,https://app.dispenco.com)
CLIENT_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Caching & Queue (Redis)
REDIS_URL="redis://localhost:6379"

# Full-Text Search (Meilisearch)
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="dispenco_master_key_must_be_at_least_16_bytes"

# AI & Document Intelligence (Google Gemini API Key)
GEMINI_API_KEY="your-gemini-api-key-here"
