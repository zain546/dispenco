# Server Configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://dispenco_user:dispenco_password@localhost:5432/dispenco_db?schema=public

# Authentication Secrets
JWT_SECRET=supersecret_jwt_access_key_change_in_production
REFRESH_TOKEN_SECRET=supersecret_jwt_refresh_key_change_in_production

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379

# Frontend Client URL
CLIENT_URL=http://localhost:3000
