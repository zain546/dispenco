# Dispenco Web (Next.js) - Environment Variables
# For local development: http://localhost:4000/api/v1
# For production: https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Private URL reachable by the Next.js server. Browser requests use /api/backend.
# Set this to the API's internal HTTPS URL in production.
API_URL="http://localhost:4000/api/v1"
