# ==========================================
# Dispenco SaaS — Production Environment Configuration
# ==========================================

# Core Server Settings
PORT=4000
NODE_ENV=production

# Database (PostgreSQL 16)
POSTGRES_USER=dispenco_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=dispenco_db
DATABASE_URL="postgresql://dispenco_user:your_secure_db_password@postgres:5432/dispenco_db?schema=public"

# Redis (Caching & Queues)
REDIS_URL="redis://redis:6379"

# Meilisearch (Medicine & Barcode Search)
MEILI_ENV=production
MEILI_MASTER_KEY=your_secure_meilisearch_master_key_16_bytes_min
MEILISEARCH_HOST="http://meilisearch:7700"
MEILISEARCH_API_KEY=your_secure_meilisearch_master_key_16_bytes_min

# Security & Authentication (Generate using: openssl rand -base64 32)
JWT_SECRET=generate_strong_random_jwt_secret_here
REFRESH_TOKEN_SECRET=generate_strong_random_refresh_token_secret_here
JWT_EXPIRATION="15m"
REFRESH_TOKEN_EXPIRATION="7d"

# Domain & CORS Origins
CLIENT_URL=https://dispenco.com
CORS_ORIGIN=https://dispenco.com

# Frontend Public API URL
NEXT_PUBLIC_API_URL=https://dispenco.com/api/v1

# AI Invoice & Slip Extraction
GEMINI_API_KEY=your_google_gemini_api_key

# Safepay Payment Gateway (Pakistan Domestic Cards, EasyPaisa, JazzCash)
# Switch between "sandbox" for test mode and "production" for live transactions
SAFEPAY_ENV=production
SAFEPAY_API_KEY=sec_live_your_safepay_public_key
SAFEPAY_SECRET_KEY=sec_live_your_safepay_secret_key
SAFEPAY_WEBHOOK_SECRET=whsec_live_your_safepay_webhook_secret
